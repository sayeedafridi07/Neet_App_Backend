// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  name            String?
  targetYear      Int?
  city            String?
  schoolName      String?
  profileComplete Boolean  @default(false)
  isActive        Boolean  @default(true)
  deviceId        String?
  fcmToken        String?
  accessToken     String?
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quizAttempts  QuizAttempt[]
  subscriptions Subscription[]
  payments      Payment[]
  dailyActivity UserDailyActivity[]

  @@index([createdAt])
  @@index([lastActiveAt])
}

// One row per user per calendar day (IST) the user made an authenticated request.
// Powers DAU/WAU/MAU and activity trends.
model UserDailyActivity {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model Admin {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String?
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)
  accessToken String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Chapter[]
}

model AcademicClass {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Chapter[]
}

model Chapter {
  id        String   @id @default(uuid())
  name      String
  slug      String
  order     Int

  classId String
  class   AcademicClass @relation(fields: [classId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  audioLectures    AudioLecture[]
  keywordRevisions KeywordRevision[]
  quizzes          Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId, slug])
  @@index([classId])
  @@index([subjectId])
}

model AudioLecture {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?

  audioKey String
  imageKey String?
  duration Int
  order    Int

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model KeywordRevision {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?

  audioKey String
  imageKey String?
  duration Int
  order    Int

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
}

enum QuizType {
  CHAPTER
  TEST_SERIES
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String?

  type QuizType

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  durationMinutes Int?

  // Marking scheme
  correctMarks Int @default(4)
  wrongMarks   Int @default(-1)
  skippedMarks Int @default(0)

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  attempts  QuizAttempt[]

  @@index([chapterId])
  @@index([type])
  @@index([isActive])
}

model Question {
  id String @id @default(uuid())

  quizId String
  quiz   Quiz @relation(fields: [quizId], references: [id])

  question    String
  explanation String?
  imageKey    String?

  explanationImageKey String?

  order    Int
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options QuestionOption[]

  @@unique([quizId, order])
  @@index([quizId])
  @@index([isActive])
}

model QuestionOption {
  id String @id @default(uuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  text      String
  isCorrect Boolean @default(false)
  imageKey  String?

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, order])
  @@index([questionId])
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

model QuizAttempt {
  id String @id @default(uuid())

  quizId String
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status QuizAttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  score          Decimal?
  correctAnswers Int @default(0)
  wrongAnswers   Int @default(0)
  skippedAnswers Int @default(0)

  // Snapshot of the complete quiz/questions at attempt creation.
  // This protects historical attempts from later admin edits.
  questionsSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAttemptAnswer[]

  @@index([quizId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

enum QuizAnswerStatus {
  NOT_ANSWERED
  ANSWERED
  MARKED
  MARKED_AND_ANSWERED
}

model QuizAttemptAnswer {
  id String @id @default(uuid())

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // These are references/identifiers only.
  // They are intentionally NOT Prisma relations because
  // the attempt uses questionsSnapshot as its historical source.
  questionId String

  questionOrder Int

  selectedOptionId String?

  status QuizAnswerStatus @default(NOT_ANSWERED)

  isCorrect Boolean?
  marks     Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId, questionOrder])
  @@index([questionId])
}

model SubscriptionPlan {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Amounts stored in the smallest currency unit (paise)
  price         Int
  originalPrice Int?
  currency      String @default("INR")

  durationDays Int

  // Feature list shown to users, e.g. ["Audio lectures", "Test series"]
  features Json?

  order    Int     @default(0)
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(PENDING)

  startsAt    DateTime?
  expiresAt   DateTime?
  cancelledAt DateTime?
  cancelAtPeriodEnd Boolean @default(false)

  // Snapshot of the plan at purchase time.
  // This protects historical subscriptions from later admin edits.
  planSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Amount in the smallest currency unit (paise)
  amount   Int
  currency String @default("INR")

  status PaymentStatus @default(CREATED)

  provider          String  @default("RAZORPAY")
  providerOrderId   String  @unique
  providerPaymentId String? @unique
  providerSignature String?

  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
}