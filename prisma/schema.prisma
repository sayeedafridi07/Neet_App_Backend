// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  phone           String   @unique
  name            String?
  targetYear      Int?
  city            String?
  schoolName      String?
  profileComplete Boolean  @default(false)
  isActive        Boolean  @default(true)
  deviceId        String?
  fcmToken        String?
  accessToken     String?
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  accessToken  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes AcademicClass[]
}

model AcademicClass {
  id        String   @id @default(uuid())
  name      String
  slug      String

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Chapter {
  id        String   @id @default(uuid())
  name      String
  slug      String
  order     Int

  classId String
  class   AcademicClass @relation(fields: [classId], references: [id])

  audioLectures AudioLecture[]
  keywordRevisions KeywordRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, slug])
  @@index([classId])
}

model AudioLecture {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?

  audioKey  String
  duration  Int
  order Int

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model KeywordRevision {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?

  audioKey  String
  duration  Int
  order Int

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
}